# ==========================================
# Configuration des clés API
# ==========================================

# OpenAI API Key (ou autre provider LLM)
# Obtenir une clé sur: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Alternative: utiliser un autre provider (décommentez si nécessaire)
# ANTHROPIC_API_KEY=your-anthropic-key
# GROQ_API_KEY=your-groq-key

# Serper.dev API Key (pour la recherche web)
# Obtenir une clé gratuite sur: https://serper.dev
SERPER_API_KEY=your-serper-api-key-here

# ==========================================
# Configuration SMTP pour l'envoi d'emails
# ==========================================

# Email de l'expéditeur (Gmail recommandé)
SMTP_SENDER_EMAIL=votre.email@gmail.com

# Mot de passe d'application Gmail
# ATTENTION: N'utilisez PAS votre mot de passe Gmail normal !
# Créez un mot de passe d'application ici:
# https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-gmail-app-password-here

# Destinataires des newsletters (séparés par des virgules)
SMTP_RECIPIENTS=destinataire1@example.com,destinataire2@example.com

# Serveur SMTP (par défaut: Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# Sujet de la newsletter
NEWSLETTER_SUBJECT=Newsletter Automatique - Intelligence Artificielle

# ==========================================
# Configuration optionnelle
# ==========================================

# Niveau de verbosité (true/false)
CREWAI_VERBOSE=true

# Modèle à utiliser (optionnel)
# OPENAI_MODEL_NAME=gpt-4
# OPENAI_MODEL_NAME=gpt-3.5-turbo
